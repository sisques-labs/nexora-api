{
  "name": "nexora-api",
  "version": "0.1.0",
  "description": "Nexora public API — entry point, orchestrates jobs, scheduler, nodes and models (mocked in v0)",
  "author": "Sisques Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/sisques-labs/nexora-api.git"
  },
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prepare": "node -e \"if(process.env.HUSKY!=='0')require('child_process').execSync('husky',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@sisques-labs/nestjs-kit": "^1.6.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.enum.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@contexts/(.*)$": "<rootDir>/contexts/$1"
    }
  },
  "lint-staged": {
    "*.ts": ["prettier --write", "eslint --fix"]
  }
}
